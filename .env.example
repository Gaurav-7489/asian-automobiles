NEXT_PUBLIC_SITE_URL=https://asian-automobiles.vercel.app
# preview (default) shows provisional facts; strict shows confirmed facts only
NEXT_PUBLIC_FACT_MODE=preview
# Mode B form delivery (leave unset to use WhatsApp hand-off / call fallback)
FORM_MODE=
ENQUIRY_TO_EMAIL=
ENQUIRY_FROM_EMAIL=
RESEND_API_KEY=
# Cookieless analytics (Plausible); leave empty to disable
NEXT_PUBLIC_ANALYTICS_DOMAIN=
# Set to 1 to enable the /dev/components preview route (never in production)
ENABLE_DEV_ROUTES=
